# Server only. Copy to .env and replace placeholders. Never use NEXT_PUBLIC_ secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/private/pocketdokani.db
SHOP_PASSCODE=replace-with-a-long-random-passcode
WEB_ORIGIN=http://localhost:3000
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/private/objects

# Production: ENVIRONMENT=production, STORAGE_BACKEND=supabase, HTTPS WEB_ORIGIN.
# Use a Supabase direct or session-pooler connection; URL-encode its password.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-key
# SUPABASE_BUCKET=pocketdokani-evidence
