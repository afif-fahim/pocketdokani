# Server only. Copy to .env and replace placeholders. Never use NEXT_PUBLIC_ secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/private/pocketdokani.db
SHOP_PASSCODE=replace-with-a-long-random-passcode
WEB_ORIGIN=http://localhost:3000
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/private/objects

# Optional Docker PostgreSQL host port; change it if 5432 is already in use.
LOCAL_DB_PORT=5432

# Meta Model API, server only. Both settings are required to enable live calls.
MODEL_CALLS_ENABLED=true
MODEL_API_KEY=
JUDGE_MODEL_CALLS_PER_HOUR=12
SELLER_MODEL_CALLS_PER_HOUR=60

# Steadfast, server only. Development uses the fake while this flag is false.
# Production seller booking stays disabled; judge sessions always use the fake.
STEADFAST_LIVE_ENABLED=false
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Production: ENVIRONMENT=production, STORAGE_BACKEND=supabase, HTTPS WEB_ORIGIN.
# Use a Supabase direct or session-pooler connection; URL-encode its password.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-key
# SUPABASE_BUCKET=pocketdokani-evidence
